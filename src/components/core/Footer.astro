---
import { Image } from "astro:assets";
const currentYear = new Date().getFullYear();
---

<footer
  class="mt-auto border-t border-zinc-200/80 dark:border-zinc-800 bg-white/50 dark:bg-zinc-950/50 backdrop-blur-xs font-sans"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      {/* Brand Column */}
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <Image
            src="/yes-life-f-only-logo.png"
            alt="Yes Life Fundas."
            width="40"
            height="40"
          />
          <span
            class="font-bold text-base tracking-tight text-zinc-950 dark:text-zinc-50"
          >
            Yes Life Fundas
          </span>
        </div>
        <p
          class="text-xs text-zinc-500 dark:text-zinc-400 max-w-sm leading-relaxed"
        >
          An editorial sanctuary devoted to somatic healing, nervous system
          restoration, timeless philosophy, and conscious intentional living.
        </p>
      </div>

      {/* Explore */}
      <div>
        <h4
          class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3"
        >
          Explore
        </h4>
        <ul class="space-y-2 text-xs text-zinc-500 dark:text-zinc-400">
          <li>
            <a
              href="/category/holistic-healing"
              class="hover:text-brand-600 transition-colors">Holistic Healing</a
            >
          </li>
          <li>
            <a
              href="/category/life-wisdom"
              class="hover:text-brand-600 transition-colors">Life & Wisdom</a
            >
          </li>
          <li>
            <a
              href="/category/mindset-philosophy"
              class="hover:text-brand-600 transition-colors"
              >Mindset & Philosophy</a
            >
          </li>
          <li>
            <a
              href="/category/intentional-living"
              class="hover:text-brand-600 transition-colors"
              >Intentional Living</a
            >
          </li>
          <li>
            <a
              href="/category/emotional-wellness"
              class="hover:text-brand-600 transition-colors"
              >Emotional Wellness</a
            >
          </li>
        </ul>
      </div>

      {/* Platform & Feeds */}
      <div>
        <h4
          class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3"
        >
          Platform
        </h4>
        <ul class="space-y-2 text-xs text-zinc-500 dark:text-zinc-400">
          <li>
            <a
              href="/sitemap.xml"
              class="hover:text-brand-600 transition-colors">Sitemap</a
            >
          </li>
          <li>
            <a href="/rss.xml" class="hover:text-brand-600 transition-colors"
              >RSS Feed</a
            >
          </li>
          <li>
            <a href="/robots.txt" class="hover:text-brand-600 transition-colors"
              >Robots.txt</a
            >
          </li>
          <li>
            <a href="/admin" class="hover:text-brand-600 transition-colors"
              >Author Studio</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="pt-8 border-t border-zinc-100 dark:border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400"
    >
      <p>© {currentYear} Yes Life Fundas. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span
          >Made with ❤️ by Yashwanth Krishnamurthy <a
            href="https://afterverse.in">@afterverse.in</a
          ></span
        >
      </p>
    </div>
  </div>
</footer>
