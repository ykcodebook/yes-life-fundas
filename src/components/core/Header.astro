---
import ThemeToggle from "./ThemeToggle.astro";
import type { Profile } from "../../lib/supabase/types";
import { Image } from "astro:assets";

interface Props {
  userProfile?: Profile | null;
}

const { userProfile } = Astro.props;

const isReader = userProfile?.role === "reader";
const isEditorOrAdmin =
  userProfile?.role === "editor" || userProfile?.role === "admin";

const navLinks = [
  { name: "Holistic Healing", href: "/category/holistic-healing" },
  { name: "Life & Wisdom", href: "/category/life-wisdom" },
  { name: "Mindset & Philosophy", href: "/category/mindset-philosophy" },
  { name: "Intentional Living", href: "/category/intentional-living" },
];
---

<header
  class="sticky top-0 z-40 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md border-b border-zinc-200/60 dark:border-zinc-800/80 transition-colors font-sans"
>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between"
  >
    {/* Brand Logo */}
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 group">
        <span
          class="w-16 h-16 rounded-xl text-white flex items-center justify-center font-bold text-sm shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform"
        >
          <Image
            src="/cropped-yeslifelogo-1.webp"
            alt="Yes Life Fundas."
            width="64"
            height="64"
          />
        </span>
        <div class="flex flex-col">
          <span
            class="font-bold text-base tracking-tight text-zinc-950 dark:text-zinc-50 group-hover:text-brand-600 transition-colors"
          >
            Yes Life Fundas
          </span>
          <span
            class="text-[9px] uppercase tracking-widest text-zinc-400 font-semibold -mt-1 hidden sm:inline"
          >
            Healing & Wisdom
          </span>
        </div>
      </a>

      {/* Desktop Navigation */}
      <nav
        class="hidden md:flex items-center gap-1 pl-4 border-l border-zinc-200 dark:border-zinc-800"
      >
        {
          navLinks.map((item) => (
            <a
              href={item.href}
              class="px-3 py-1.5 rounded-lg text-xs font-semibold text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 transition-colors"
            >
              {item.name}
            </a>
          ))
        }
      </nav>
    </div>

    {/* Right Header Actions */}
    <div class="flex items-center gap-2 sm:gap-3">
      {/* Search Button */}
      <a
        href="/search"
        class="p-2 rounded-xl text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
        aria-label="Search articles"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </a>

      {/* Dark/Light Toggle */}
      <ThemeToggle />

      {/* Role-Aware Action Buttons */}
      {
        isEditorOrAdmin ? (
          /* Editors & Admins: + Write Button */
          <a
            href="/admin/editor/new"
            class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold shadow-sm shadow-brand-500/25 transition-all active:scale-95"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 4v16m8-8H4"
              />
            </svg>
            <span>Write</span>
          </a>
        ) : isReader ? (
          /* Readers: Apply to Become Editor */
          <a
            href="/apply-editor"
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-brand-50 dark:bg-brand-950/70 hover:bg-brand-100 dark:hover:bg-brand-900/80 text-brand-700 dark:text-brand-300 text-xs font-bold transition-all border border-brand-200/80 dark:border-brand-800/80 shadow-2xs"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
              />
            </svg>
            <span>Apply to Write</span>
          </a>
        ) : (
          /* Anonymous Guests: Apply to Write */
          <a
            href="/apply-editor"
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs font-bold transition-all"
          >
            <svg
              class="w-3.5 h-3.5 text-brand-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
              />
            </svg>
            <span>Write</span>
          </a>
        )
      }

      {/* User Session Profile / Login */}
      {
        userProfile ? (
          <div class="flex items-center gap-2 pl-2 border-l border-zinc-200 dark:border-zinc-800">
            {isEditorOrAdmin ? (
              <a
                href="/admin"
                class="flex items-center gap-2 p-1 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
                title="Studio Dashboard"
              >
                {userProfile.avatar_url ? (
                  <img
                    src={userProfile.avatar_url}
                    alt={userProfile.full_name}
                    class="w-7 h-7 rounded-full object-cover ring-2 ring-brand-500/30"
                  />
                ) : (
                  <div class="w-7 h-7 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs font-bold">
                    {userProfile.full_name?.charAt(0) || "U"}
                  </div>
                )}
                <span class="text-xs font-bold hidden md:inline text-zinc-800 dark:text-zinc-200">
                  {userProfile.role === "admin" ? "Master Admin" : "Studio"}
                </span>
              </a>
            ) : (
              <div class="flex items-center gap-2">
                <a
                  href="/apply-editor"
                  class="flex items-center gap-1.5 p-1 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
                  title="Reader Account"
                >
                  <div class="w-7 h-7 rounded-full bg-zinc-200 dark:bg-zinc-700 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-xs font-bold">
                    {userProfile.full_name?.charAt(0) || "R"}
                  </div>
                  <span class="text-xs font-medium hidden md:inline text-zinc-600 dark:text-zinc-400">
                    Reader
                  </span>
                </a>
                <a
                  href="/auth/logout"
                  class="text-xs text-zinc-400 hover:text-rose-500 p-1"
                  title="Sign out"
                >
                  Sign out
                </a>
              </div>
            )}
          </div>
        ) : (
          <a
            href="/auth/login"
            class="inline-flex items-center px-4 py-1.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold shadow-md shadow-brand-500/20 transition-all"
          >
            Sign In
          </a>
        )
      }

      {/* Mobile Menu Button */}
      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden p-2 rounded-xl text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800"
        aria-label="Open mobile menu"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Navigation Drawer */}
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 py-4 space-y-2"
  >
    {
      navLinks.map((item) => (
        <a
          href={item.href}
          class="block px-3 py-2 rounded-xl text-sm font-semibold text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800"
        >
          {item.name}
        </a>
      ))
    }
    <div
      class="pt-2 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between"
    >
      {
        isEditorOrAdmin ? (
          <a href="/admin/editor/new" class="text-xs font-bold text-brand-600">
            + Write Article
          </a>
        ) : (
          <a href="/apply-editor" class="text-xs font-bold text-brand-600">
            Apply to Write
          </a>
        )
      }
      {
        userProfile ? (
          <a
            href={isEditorOrAdmin ? "/admin" : "/apply-editor"}
            class="text-xs font-bold text-zinc-600 dark:text-zinc-400"
          >
            {isEditorOrAdmin ? "Admin Studio" : "Reader Profile"}
          </a>
        ) : (
          <a href="/auth/login" class="text-xs font-bold text-brand-600">
            Sign In
          </a>
        )
      }
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>
