---
import type { Profile } from '../../lib/supabase/types';

interface Props {
  author?: Profile;
}

const { author } = Astro.props;
if (!author) return null;
---

<div class="bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 rounded-2xl p-6 my-10 font-sans">
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
    {author.avatar_url ? (
      <img
        src={author.avatar_url}
        alt={author.full_name}
        class="w-14 h-14 rounded-2xl object-cover ring-2 ring-brand-500/20"
      />
    ) : (
      <div class="w-14 h-14 rounded-2xl bg-brand-600 text-white flex items-center justify-center text-xl font-bold">
        {author.full_name?.charAt(0) || 'A'}
      </div>
    )}

    <div class="flex-1 space-y-1">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-[10px] uppercase font-bold tracking-wider text-zinc-400">Written by</span>
          <h4 class="text-base font-bold text-zinc-950 dark:text-zinc-50">
            <a href={`/author/${author.username}`} class="hover:text-brand-600 transition-colors">
              {author.full_name}
            </a>
          </h4>
        </div>

        {author.twitter && (
          <a
            href={`https://twitter.com/${author.twitter}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-brand-600 hover:underline"
          >
            @{author.twitter}
          </a>
        )}
      </div>

      <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
        {author.bio || 'Writer and contributor on Yes Life Fundas exploring systems, intentional living, and engineering.'}
      </p>
    </div>
  </div>
</div>
