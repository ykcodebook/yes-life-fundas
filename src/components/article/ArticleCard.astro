---
import type { Article } from '../../lib/supabase/types';
import { formatShortDate } from '../../lib/utils/format-date';

interface Props {
  article: Article;
  featured?: boolean;
  horizontal?: boolean;
}

const { article, featured = false, horizontal = false } = Astro.props;
const articleUrl = `/articles/${article.slug}`;
---

<article
  class={`article-card article-protected select-none group relative bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-2xl overflow-hidden hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-lg transition-all duration-300 flex ${
    featured
      ? 'flex-col lg:flex-row lg:items-center'
      : horizontal
      ? 'flex-col sm:flex-row'
      : 'flex-col'
  }`}
  data-protected="true"
>
  {/* Cover Image */}
  {article.cover_image && (
    <div
      class={`overflow-hidden bg-zinc-100 dark:bg-zinc-800 ${
        featured
          ? 'w-full lg:w-3/5 aspect-[16/10] lg:aspect-auto lg:h-[400px]'
          : horizontal
          ? 'w-full sm:w-1/3 aspect-[16/10] sm:aspect-auto'
          : 'w-full aspect-[16/10]'
      }`}
    >
      <a href={articleUrl} class="block w-full h-full">
        <img
          src={article.cover_image}
          alt={article.cover_image_alt || article.title}
          loading={featured ? 'eager' : 'lazy'}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </a>
    </div>
  )}

  {/* Content Details */}
  <div
    class={`flex flex-col justify-between flex-1 ${
      featured ? 'p-6 sm:p-10 lg:w-2/5' : 'p-5 sm:p-6'
    }`}
  >
    <div>
      {/* Top Meta: Category & Reading Time */}
      <div class="flex items-center gap-2 mb-3">
        {article.category && (
          <a
            href={`/category/${article.category.slug}`}
            class="px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wide uppercase transition-colors"
            style={{
              backgroundColor: `${article.category.color}15`,
              color: article.category.color,
            }}
          >
            {article.category.name}
          </a>
        )}
        <span class="text-zinc-300 dark:text-zinc-700">•</span>
        <span class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">
          {article.reading_time_minutes} min read
        </span>
      </div>

      {/* Title */}
      <h3
        class={`font-bold font-sans tracking-tight text-zinc-950 dark:text-zinc-50 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors leading-snug ${
          featured ? 'text-2xl sm:text-3xl mb-3' : 'text-lg sm:text-xl mb-2'
        }`}
      >
        <a href={articleUrl}>
          {article.title}
        </a>
      </h3>

      {/* Excerpt */}
      {article.excerpt && (
        <p
          class={`font-serif text-zinc-600 dark:text-zinc-300 leading-relaxed line-clamp-2 ${
            featured ? 'text-base sm:text-lg mb-6 line-clamp-3' : 'text-sm mb-4'
          }`}
        >
          {article.excerpt}
        </p>
      )}
    </div>

    {/* Author & Publication Date */}
    <div class="flex items-center justify-between pt-4 border-t border-zinc-100 dark:border-zinc-800/80 mt-auto">
      <div class="flex items-center gap-2.5">
        {article.author?.avatar_url ? (
          <img
            src={article.author.avatar_url}
            alt={article.author.full_name}
            class="w-7 h-7 rounded-full object-cover"
          />
        ) : (
          <div class="w-7 h-7 rounded-full bg-brand-100 dark:bg-brand-950 text-brand-700 dark:text-brand-300 flex items-center justify-center text-xs font-bold font-sans">
            {article.author?.full_name?.charAt(0) || 'A'}
          </div>
        )}
        <div>
          {article.author?.username ? (
            <a
              href={`/author/${article.author.username}`}
              class="text-xs font-bold text-zinc-800 dark:text-zinc-200 hover:text-brand-600"
            >
              {article.author.full_name}
            </a>
          ) : (
            <span class="text-xs font-bold text-zinc-800 dark:text-zinc-200">
              {article.author?.full_name || 'Author'}
            </span>
          )}
        </div>
      </div>

      <time
        datetime={article.published_at || article.created_at}
        class="text-[11px] text-zinc-400 font-sans"
      >
        {formatShortDate(article.published_at || article.created_at)}
      </time>
    </div>
  </div>
</article>
