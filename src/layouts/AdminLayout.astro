---
import BaseLayout from './BaseLayout.astro';
import { getUserFromCookies } from '../lib/supabase/server';

interface Props {
  title?: string;
}

const { title = 'Admin Studio | Yes Life Fundas' } = Astro.props;

const userWithProfile = await getUserFromCookies(Astro.cookies);
const userProfile = userWithProfile?.profile;

const isReader = userProfile?.role === 'reader';
const isEditorOrAdmin = userProfile?.role === 'editor' || userProfile?.role === 'admin';

const navItems = [
  { name: 'Dashboard', href: '/admin', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { name: 'Articles', href: '/admin/articles', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z' },
  { name: 'Comments', href: '/admin/comments', icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
  { name: 'Categories & Tags', href: '/admin/categories', icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z' },
  { name: 'Media Library', href: '/admin/media', icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z' },
];

if (userProfile?.role === 'admin') {
  navItems.push({
    name: 'User Roles & Approvals',
    href: '/admin/users',
    icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  });
}

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} noindex={true}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 font-sans">
    {!userWithProfile ? (
      /* Fallback for unauthenticated access without throwing ResponseSentError */
      <div class="max-w-md mx-auto my-16 p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center shadow-xl space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-950 text-brand-600 mx-auto flex items-center justify-center font-bold text-xl">
          🔒
        </div>
        <h2 class="text-xl font-bold text-zinc-950 dark:text-zinc-50">Authentication Required</h2>
        <p class="text-xs text-zinc-500">Please sign in to access the author studio and administrative tools.</p>
        <div class="pt-2">
          <a href={`/auth/login?redirect=${encodeURIComponent(currentPath)}`} class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold shadow-md transition-all">
            Sign In Now
          </a>
        </div>
      </div>
    ) : isReader ? (
      /* Fallback for Readers without throwing ResponseSentError */
      <div class="max-w-md mx-auto my-16 p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center shadow-xl space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950 text-amber-600 mx-auto flex items-center justify-center font-bold text-xl">
          ✍️
        </div>
        <h2 class="text-xl font-bold text-zinc-950 dark:text-zinc-50">Editor Access Required</h2>
        <p class="text-xs text-zinc-500">Your account is currently a Reader. Submit a quick application to become an Editor and start publishing.</p>
        <div class="pt-2 flex items-center justify-center gap-3">
          <a href="/apply-editor" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold shadow-md transition-all">
            Apply to Become Editor
          </a>
          <a href="/" class="px-4 py-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-semibold hover:bg-zinc-200 transition-all">
            Home
          </a>
        </div>
      </div>
    ) : (
      /* Authorized Layout */
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
        {/* Sidebar Navigation */}
        <aside class="lg:col-span-1 space-y-4">
          {/* User Card */}
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
            <div class="flex items-center gap-3">
              {userProfile?.avatar_url ? (
                <img src={userProfile.avatar_url} alt={userProfile.full_name} class="w-10 h-10 rounded-xl object-cover" />
              ) : (
                <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-sm">
                  {userProfile?.full_name?.charAt(0) || 'U'}
                </div>
              )}
              <div class="overflow-hidden">
                <div class="font-bold text-xs text-zinc-900 dark:text-zinc-100 truncate">
                  {userProfile?.full_name || 'User'}
                </div>
                <span class={`inline-block px-2 py-0.5 rounded-md text-[10px] font-bold uppercase ${
                  userProfile?.role === 'admin'
                    ? 'bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300'
                    : 'bg-brand-100 dark:bg-brand-950 text-brand-700 dark:text-brand-300'
                }`}>
                  {userProfile?.role === 'admin' ? 'Master Admin' : 'Editor'}
                </span>
              </div>
            </div>
          </div>

          {/* Navigation Links */}
          <nav class="space-y-1 bg-white dark:bg-zinc-900 p-2 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-2xs">
            {navItems.map((item) => {
              const isActive = currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
                    isActive
                      ? 'bg-brand-600 text-white shadow-xs'
                      : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-950 dark:hover:text-zinc-50'
                  }`}
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                  </svg>
                  <span>{item.name}</span>
                </a>
              );
            })}
          </nav>

          {/* Quick Write CTA */}
          <a
            href="/admin/editor/new"
            class="flex items-center justify-center gap-2 w-full py-3 rounded-2xl bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-zinc-200 text-white dark:text-zinc-900 text-xs font-bold shadow-md transition-all"
          >
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            New Article
          </a>

          {/* Logout */}
          <a
            href="/auth/logout"
            class="block text-center text-xs text-zinc-400 hover:text-rose-500 py-2 transition-colors"
          >
            Sign Out
          </a>
        </aside>

        {/* Main Studio Content Area */}
        <main class="lg:col-span-4">
          <slot />
        </main>
      </div>
    )}
  </div>
</BaseLayout>
