---
import Header from '../components/core/Header.astro';
import Footer from '../components/core/Footer.astro';
import { getUserFromCookies } from '../lib/supabase/server';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  noindex?: boolean;
}

const {
  title = 'Yes Life Fundas — Wisdom, Engineering & Focus',
  description = 'A modern SEO-first article publishing platform dedicated to wisdom, engineering craft, deep work habits, and intentional living.',
  canonicalUrl,
  ogImage = '/og-image.jpg',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  authorName,
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const currentCanonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;

// Extract user from SSR session cookies
const userWithProfile = await getUserFromCookies(Astro.cookies);
const userProfile = userWithProfile?.profile || null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={currentCanonical} />

    {/* Robots directives */}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content="Yes Life Fundas" />

    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {authorName && <meta property="article:author" content={authorName} />}

    {/* Twitter Cards */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={currentCanonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />

    {/* RSS feed auto-discovery */}
    <link rel="alternate" type="application/rss+xml" title="Yes Life Fundas RSS Feed" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    {/* Inline script to prevent theme flash */}
    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="bg-paper-50 dark:bg-paper-950 text-zinc-900 dark:text-zinc-100 flex flex-col min-h-screen">
    <Header userProfile={userProfile} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    {/* Content Protection Script: Disable text select and copy on articles and cards */}
    <script is:inline>
      (function() {
        function isProtectedTarget(target) {
          if (!target || !(target instanceof Element)) return false;
          // Never restrict interactive form controls, editable content, discussions, or editor canvas
          if (target.closest('input, textarea, [contenteditable="true"], .select-text, #discussion, .editor-canvas')) {
            return false;
          }
          // Only restrict elements marked as protected, article cards, or article content
          return !!target.closest('.article-protected, .article-card, .article-body, [data-protected="true"]');
        }

        // 1. Prevent copy event on protected elements
        document.addEventListener('copy', function(e) {
          const activeEl = document.activeElement;
          if (activeEl && activeEl.closest('input, textarea, [contenteditable="true"], .select-text, #discussion, .editor-canvas')) {
            return;
          }
          const selection = window.getSelection();
          if (!selection || selection.rangeCount === 0) return;
          const anchorNode = selection.anchorNode;
          const anchorEl = anchorNode instanceof Element ? anchorNode : anchorNode?.parentElement;
          if (isProtectedTarget(anchorEl) || isProtectedTarget(e.target)) {
            e.preventDefault();
          }
        }, true);

        // 2. Prevent cut event on protected elements
        document.addEventListener('cut', function(e) {
          if (isProtectedTarget(e.target)) {
            e.preventDefault();
          }
        }, true);

        // 3. Prevent text selection dragging start on protected elements
        document.addEventListener('selectstart', function(e) {
          if (isProtectedTarget(e.target)) {
            e.preventDefault();
          }
        }, true);

        // 4. Prevent context menu on protected elements, preserving right-click for links and buttons
        document.addEventListener('contextmenu', function(e) {
          if (isProtectedTarget(e.target)) {
            if (e.target.closest('a, button')) {
              return; // Allow context menu on links (e.g., Open link in new tab)
            }
            e.preventDefault();
          }
        }, true);

        // 5. Intercept Ctrl+C / Cmd+C / Ctrl+A / Cmd+A shortcuts on protected content
        document.addEventListener('keydown', function(e) {
          const isCmdOrCtrl = e.ctrlKey || e.metaKey;
          if (!isCmdOrCtrl) return;
          const key = e.key.toLowerCase();
          if (key === 'c' || key === 'a' || key === 'x') {
            const activeEl = document.activeElement;
            if (activeEl && activeEl.closest('input, textarea, [contenteditable="true"], .select-text, #discussion, .editor-canvas')) {
              return;
            }
            const selection = window.getSelection();
            const anchorNode = selection?.anchorNode;
            const anchorEl = anchorNode instanceof Element ? anchorNode : anchorNode?.parentElement;
            if (isProtectedTarget(anchorEl) || isProtectedTarget(e.target)) {
              e.preventDefault();
            }
          }
        }, true);
      })();
    </script>
  </body>
</html>
