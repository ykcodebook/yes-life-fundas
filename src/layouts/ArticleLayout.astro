---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/core/Breadcrumbs.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import ShareButtons from '../components/article/ShareButtons.tsx';
import AuthorBio from '../components/article/AuthorBio.astro';
import RelatedArticles from '../components/article/RelatedArticles.astro';
import CommentSection from '../components/comments/CommentSection.tsx';
import type { Article } from '../lib/supabase/types';
import { generateArticleJsonLd } from '../lib/utils/seo';
import { extractHeadingsFromContent } from '../lib/tiptap/json-to-html';
import { formatShortDate } from '../lib/utils/format-date';

interface Props {
  article: Article;
  relatedArticles?: Article[];
}

const { article, relatedArticles = [] } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const articleUrl = `${siteUrl}/articles/${article.slug}`;

const headings = extractHeadingsFromContent(article.published_content || article.draft_content);
const articleJsonLd = generateArticleJsonLd(article, siteUrl);

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  ...(article.category ? [{ name: article.category.name, url: `/category/${article.category.slug}` }] : []),
  { name: article.title, url: articleUrl },
];
---

<BaseLayout
  title={`${article.seo_title || article.title} | Yes Life Fundas`}
  description={article.seo_description || article.excerpt}
  canonicalUrl={article.canonical_url || articleUrl}
  ogImage={article.social_image || article.cover_image}
  ogType="article"
  publishedTime={article.published_at || article.created_at}
  modifiedTime={article.updated_at}
  authorName={article.author?.full_name}
>
  {/* Reading Progress Bar */}
  <div
    id="reading-progress"
    class="fixed top-16 left-0 h-1 bg-brand-500 z-50 transition-all duration-75 w-0"
    role="progressbar"
    aria-label="Reading progress"
  />

  {/* Schema.org BlogPosting / Article structured data */}
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    {/* Breadcrumbs */}
    <Breadcrumbs items={breadcrumbItems} />

    {/* Article Header */}
    <header class="mb-8 font-sans">
      {/* Category Pill */}
      {article.category && (
        <div class="mb-4">
          <a
            href={`/category/${article.category.slug}`}
            class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider transition-colors"
            style={{
              backgroundColor: `${article.category.color}15`,
              color: article.category.color,
            }}
          >
            {article.category.name}
          </a>
        </div>
      )}

      {/* Main H1 Title */}
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 dark:text-zinc-50 leading-[1.15] mb-4">
        {article.title}
      </h1>

      {/* Subtitle / Excerpt */}
      {article.subtitle && (
        <p class="text-lg sm:text-xl font-serif text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
          {article.subtitle}
        </p>
      )}

      {/* Author & Reading Time Bar */}
      <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-zinc-200/80 dark:border-zinc-800 text-xs">
        <div class="flex items-center gap-3">
          {article.author?.avatar_url ? (
            <img
              src={article.author.avatar_url}
              alt={article.author.full_name}
              class="w-10 h-10 rounded-full object-cover ring-2 ring-brand-500/20"
            />
          ) : (
            <div class="w-10 h-10 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold">
              {article.author?.full_name?.charAt(0) || 'A'}
            </div>
          )}
          <div>
            <div class="font-bold text-zinc-900 dark:text-zinc-100">
              {article.author?.username ? (
                <a href={`/author/${article.author.username}`} class="hover:text-brand-600">
                  {article.author.full_name}
                </a>
              ) : (
                article.author?.full_name || 'Author'
              )}
            </div>
            <div class="text-zinc-500 text-[11px] flex items-center gap-1.5 mt-0.5">
              <span>{formatShortDate(article.published_at || article.created_at)}</span>
              <span>•</span>
              <span>{article.reading_time_minutes} min read</span>
            </div>
          </div>
        </div>

        {/* Social Share Controls */}
        <ShareButtons client:visible title={article.title} url={articleUrl} />
      </div>
    </header>

    {/* Featured Cover Image */}
    {article.cover_image && (
      <figure class="my-8">
        <img
          src={article.cover_image}
          alt={article.cover_image_alt || article.title}
          loading="eager"
          class="w-full max-h-[480px] object-cover rounded-2xl shadow-md"
        />
        {article.cover_image_caption && (
          <figcaption class="mt-2 text-center text-xs text-zinc-500 font-sans italic">
            {article.cover_image_caption}
          </figcaption>
        )}
      </figure>
    )}

    {/* Table of Contents */}
    <TableOfContents headings={headings} />

    {/* Slot for Main Article HTML Content */}
    <div class="article-body font-serif">
      <slot />
    </div>

    {/* Article Tags Cloud */}
    {article.tags && article.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 my-10 pt-6 border-t border-zinc-200 dark:border-zinc-800 font-sans">
        <span class="text-xs font-bold text-zinc-400 self-center mr-1">Tags:</span>
        {article.tags.map((tag) => (
          <a
            href={`/tag/${tag.slug}`}
            class="px-3 py-1 rounded-full text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-brand-500 hover:text-white transition-all"
          >
            #{tag.name}
          </a>
        ))}
      </div>
    )}

    {/* Author Bio Box */}
    <AuthorBio author={article.author} />

    {/* Related Articles */}
    <RelatedArticles articles={relatedArticles} />

    {/* Threaded Comments Section */}
    <CommentSection client:visible articleId={article.id} />
  </article>

  {/* Reading Progress Bar Scroll Script */}
  <script is:inline>
    const progressBar = document.getElementById('reading-progress');
    window.addEventListener('scroll', () => {
      const totalScroll = document.documentElement.scrollTop;
      const windowHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      if (windowHeight > 0) {
        const scrollPercent = (totalScroll / windowHeight) * 100;
        if (progressBar) progressBar.style.width = scrollPercent + '%';
      }
    });
  </script>
</BaseLayout>
