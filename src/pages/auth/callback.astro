---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createServerSupabaseClient } from '../../lib/supabase/server';

const code = Astro.url.searchParams.get('code');
const tokenHash = Astro.url.searchParams.get('token_hash');
const type = Astro.url.searchParams.get('type');
const targetRedirect = Astro.url.searchParams.get('redirect') || '/admin';

let serverError = '';

if (code) {
  // Exchange PKCE authorization code for session on the server
  const client = createServerSupabaseClient();
  const { data, error } = await client.auth.exchangeCodeForSession(code);

  if (error) {
    serverError = error.message;
  } else if (data.session) {
    // Set cookies
    Astro.cookies.set('sb-access-token', data.session.access_token, {
      path: '/',
      httpOnly: false,
      secure: import.meta.env.PROD,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7,
    });
    Astro.cookies.set('sb-refresh-token', data.session.refresh_token, {
      path: '/',
      httpOnly: false,
      secure: import.meta.env.PROD,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7,
    });

    // Fetch user profile to determine redirect target
    const { data: profile } = await client
      .from('profiles')
      .select('role')
      .eq('id', data.session.user.id)
      .maybeSingle();

    if (profile?.role === 'reader') {
      return Astro.redirect('/apply-editor');
    }
    return Astro.redirect(targetRedirect);
  }
} else if (tokenHash && type === 'email') {
  // Exchange token hash
  const client = createServerSupabaseClient();
  const { data, error } = await client.auth.verifyOtp({
    token_hash: tokenHash,
    type: 'email',
  });

  if (error) {
    serverError = error.message;
  } else if (data.session) {
    Astro.cookies.set('sb-access-token', data.session.access_token, {
      path: '/',
      httpOnly: false,
      secure: import.meta.env.PROD,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7,
    });
    Astro.cookies.set('sb-refresh-token', data.session.refresh_token, {
      path: '/',
      httpOnly: false,
      secure: import.meta.env.PROD,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7,
    });

    const { data: profile } = await client
      .from('profiles')
      .select('role')
      .eq('id', data.session.user.id)
      .maybeSingle();

    if (profile?.role === 'reader') {
      return Astro.redirect('/apply-editor');
    }
    return Astro.redirect(targetRedirect);
  }
}
---

<BaseLayout title="Authenticating | Yes Life Fundas" noindex={true}>
  <div class="min-h-[70vh] flex items-center justify-center px-4 font-sans">
    <div class="w-full max-w-md p-8 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl shadow-xl text-center space-y-4">
      {serverError ? (
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-full bg-rose-100 dark:bg-rose-950 text-rose-600 mx-auto flex items-center justify-center font-bold text-xl">
            ✕
          </div>
          <h2 class="text-lg font-bold text-zinc-950 dark:text-zinc-50">Confirmation Error</h2>
          <p class="text-xs text-zinc-500">{serverError}</p>
          <div class="pt-2">
            <a href="/auth/login" class="inline-block px-5 py-2.5 rounded-xl bg-brand-600 text-white text-xs font-bold shadow-md">
              Back to Sign In
            </a>
          </div>
        </div>
      ) : (
        <div class="space-y-3" id="auth-loading-container">
          <div class="w-10 h-10 border-3 border-brand-500 border-t-transparent rounded-full animate-spin mx-auto"></div>
          <h2 class="text-base font-bold text-zinc-950 dark:text-zinc-50">Confirming your account...</h2>
          <p class="text-xs text-zinc-500">Setting up your secure session. You will be redirected momentarily.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

{/* Client-side handling for Implicit Hash Fragment (#access_token=...) */}
<script>
  import { supabase } from '../../lib/supabase/client';

  async function handleClientCallback() {
    try {
      // 1. Check if hash contains access_token or if supabase has session
      const { data: { session }, error } = await supabase.auth.getSession();

      if (session) {
        // Set cookie on client
        document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=604800; SameSite=Lax`;
        document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=604800; SameSite=Lax`;

        // Check role
        const { data: profile } = await supabase
          .from('profiles')
          .select('role')
          .eq('id', session.user.id)
          .maybeSingle();

        if (profile?.role === 'reader') {
          window.location.href = '/apply-editor';
        } else {
          window.location.href = '/admin';
        }
      } else {
        // Listen to auth state change (in case supabase-js is parsing hash)
        supabase.auth.onAuthStateChange(async (event, newSession) => {
          if (newSession) {
            document.cookie = `sb-access-token=${newSession.access_token}; path=/; max-age=604800; SameSite=Lax`;
            document.cookie = `sb-refresh-token=${newSession.refresh_token}; path=/; max-age=604800; SameSite=Lax`;

            const { data: profile } = await supabase
              .from('profiles')
              .select('role')
              .eq('id', newSession.user.id)
              .maybeSingle();

            if (profile?.role === 'reader') {
              window.location.href = '/apply-editor';
            } else {
              window.location.href = '/admin';
            }
          }
        });
      }
    } catch (e) {
      console.error('Client auth callback error:', e);
    }
  }

  handleClientCallback();
</script>
