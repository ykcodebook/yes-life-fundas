---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
import { createServerSupabaseClient } from '../lib/supabase/server';

const query = Astro.url.searchParams.get('q')?.trim() || '';
const client = createServerSupabaseClient(Astro.cookies);

// Fetch popular tags for quick topic chips
const { data: popularTags } = await client.from('tags').select('*').limit(12);

let searchResults: any[] = [];

if (query) {
  // 1. Perform comprehensive full-text & keyword search via RPC function
  const { data: rpcResults, error } = await client.rpc('search_articles', {
    search_query: query,
  });

  if (!error && rpcResults && rpcResults.length > 0) {
    const articleIds = rpcResults.map((r: any) => r.id);

    // Fetch author and category relations for matched articles
    const { data: fullArticles } = await client
      .from('articles')
      .select('*, author:profiles(*), category:categories(*)')
      .in('id', articleIds);

    if (fullArticles) {
      // Preserve relevance score ranking
      const articleMap = new Map(fullArticles.map((a) => [a.id, a]));
      searchResults = rpcResults
        .map((r: any) => articleMap.get(r.id))
        .filter(Boolean);
    }
  } else {
    // Flexible tokenized fallback search across all fields
    const tokens = query.split(/\s+/).map((t) => t.trim().toLowerCase()).filter((t) => t.length >= 2);
    const filterTokens = tokens.length > 0 ? tokens : [query.toLowerCase()];

    let queryBuilder = client
      .from('articles')
      .select('*, author:profiles(*), category:categories(*)')
      .eq('status', 'published');

    const orConditions = filterTokens
      .map((t) => `title.ilike.%${t}%,excerpt.ilike.%${t}%,subtitle.ilike.%${t}%,seo_description.ilike.%${t}%`)
      .join(',');

    const { data: fallbackArticles } = await queryBuilder
      .or(orConditions)
      .order('published_at', { ascending: false });

    searchResults = fallbackArticles || [];
  }
}
---

<BaseLayout
  title={query ? `Search: "${query}" | Yes Life Fundas` : 'Search & Discover | Yes Life Fundas'}
  description="Search across articles, full essay content, topics, and authors on Yes Life Fundas."
  noindex={true}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8 font-sans">
    {/* Search Box Header */}
    <div class="text-center space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-brand-300 text-xs font-bold font-sans">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Universal Search
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-zinc-50">
        Search Articles & Topics
      </h1>
      <p class="text-xs sm:text-sm text-zinc-500 max-w-md mx-auto leading-relaxed">
        Search keywords across titles, full article content, categories, and tags.
      </p>

      {/* Main Search Input Form */}
      <form method="GET" action="/search" class="max-w-xl mx-auto mt-6 relative">
        <input
          type="search"
          name="q"
          value={query}
          placeholder="Search by keyword, topic, or content..."
          class="w-full pl-12 pr-28 py-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm text-zinc-900 dark:text-zinc-100 shadow-md outline-none focus:border-brand-500 transition-colors"
          autofocus
        />
        <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <button
          type="submit"
          class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white rounded-xl text-xs font-bold shadow-xs transition-all"
        >
          Search
        </button>
      </form>

      {/* Quick Topic Suggestions */}
      {popularTags && popularTags.length > 0 && (
        <div class="flex flex-wrap items-center justify-center gap-1.5 pt-3">
          <span class="text-xs text-zinc-400 font-semibold mr-1">Popular:</span>
          {popularTags.map((tag) => (
            <a
              href={`/search?q=${encodeURIComponent(tag.name)}`}
              class={`px-2.5 py-1 rounded-full text-xs font-medium transition-all ${
                query.toLowerCase() === tag.name.toLowerCase()
                  ? 'bg-brand-600 text-white shadow-xs'
                  : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-zinc-700'
              }`}
            >
              #{tag.name}
            </a>
          ))}
        </div>
      )}
    </div>

    {/* Search Results Display */}
    {query ? (
      <div class="space-y-6 pt-4">
        <div class="flex items-center justify-between border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3 text-xs">
          <span class="text-zinc-600 dark:text-zinc-300">
            Found <strong>{searchResults.length}</strong> {searchResults.length === 1 ? 'result' : 'results'} matching "<span class="text-brand-600 font-bold">{query}</span>"
          </span>
          <span class="text-zinc-400">Ranked by relevance</span>
        </div>

        {searchResults.length === 0 ? (
          <div class="py-16 text-center text-zinc-400 bg-white dark:bg-zinc-900 rounded-3xl border border-dashed border-zinc-200 dark:border-zinc-800 p-8 space-y-2">
            <svg class="w-10 h-10 mx-auto text-zinc-300 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="text-sm font-bold text-zinc-700 dark:text-zinc-300">No matching articles found</h3>
            <p class="text-xs max-w-sm mx-auto">
              We couldn't find any articles containing "{query}" across titles, content, or tags. Try searching for a broader term or explore categories.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {searchResults.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        )}
      </div>
    ) : (
      <div class="py-16 text-center space-y-3 bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200/80 dark:border-zinc-800 p-8">
        <svg class="w-12 h-12 mx-auto text-brand-600/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <h3 class="text-base font-bold text-zinc-800 dark:text-zinc-200">Search the entire knowledge base</h3>
        <p class="text-xs text-zinc-500 max-w-sm mx-auto">
          Type any keyword above to search through long-form essays, code tutorials, and intentional living principles.
        </p>
      </div>
    )}
  </div>
</BaseLayout>
