---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import Breadcrumbs from '../../components/core/Breadcrumbs.astro';
import { createServerSupabaseClient } from '../../lib/supabase/server';

const { slug } = Astro.params;
const client = createServerSupabaseClient(Astro.cookies);

// Fetch Tag
const { data: tag } = await client
  .from('tags')
  .select('*')
  .eq('slug', slug)
  .single();

if (!tag) {
  return Astro.rewrite('/404');
}

// Fetch articles associated with this tag
const { data: taggedArticles } = await client
  .from('article_tags')
  .select('article:articles(*, author:profiles(*), category:categories(*))')
  .eq('tag_id', tag.id);

const articles = taggedArticles
  ?.map((ta: any) => ta.article)
  .filter((a: any) => a && a.status === 'published') || [];

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Tags', url: '/' },
  { name: `#${tag.name}`, url: `/tag/${tag.slug}` },
];
---

<BaseLayout
  title={`#${tag.name} Articles | Yes Life Fundas`}
  description={`Browse articles tagged with #${tag.name}`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8 font-sans">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="border-b border-zinc-200/80 dark:border-zinc-800/80 pb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-zinc-50">
        #{tag.name}
      </h1>
      <p class="text-xs text-zinc-500 mt-1">
        {articles.length} {articles.length === 1 ? 'article' : 'articles'} filed under this topic.
      </p>
    </div>

    {articles.length === 0 ? (
      <div class="py-16 text-center text-zinc-400 bg-white dark:bg-zinc-900 rounded-3xl border border-dashed border-zinc-200 dark:border-zinc-800 p-8">
        No published articles with this tag yet.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {articles.map((article: any) => (
          <ArticleCard article={article} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
