---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createServerSupabaseClient, getUserFromCookies } from '../../lib/supabase/server';
import { formatShortDate } from '../../lib/utils/format-date';

const userWithProfile = await getUserFromCookies(Astro.cookies);
const userRole = userWithProfile?.profile?.role || 'editor';

const client = createServerSupabaseClient(Astro.cookies);

// Fetch stats
const [{ count: totalArticles }, { count: draftArticles }, { count: publishedArticles }, { count: totalComments }, { count: pendingRequestsCount }] = await Promise.all([
  client.from('articles').select('*', { count: 'exact', head: true }),
  client.from('articles').select('*', { count: 'exact', head: true }).eq('status', 'draft'),
  client.from('articles').select('*', { count: 'exact', head: true }).eq('status', 'published'),
  client.from('comments').select('*', { count: 'exact', head: true }),
  client.from('editor_requests').select('*', { count: 'exact', head: true }).eq('status', 'pending'),
]);

// Fetch recent articles
const { data: recentArticles } = await client
  .from('articles')
  .select('*, category:categories(*)')
  .order('updated_at', { ascending: false })
  .limit(5);

// Fetch pending editor requests if Admin
let pendingEditorRequests: any[] = [];
if (userRole === 'admin') {
  const { data: reqs } = await client
    .from('editor_requests')
    .select('*, user:profiles!user_id(*)')
    .eq('status', 'pending')
    .order('created_at', { ascending: false })
    .limit(5);
  pendingEditorRequests = reqs || [];
}
---

<AdminLayout title="Dashboard Overview | Studio">
  <div class="space-y-8 font-sans">
    {/* Welcome Hero Banner */}
    <div class="relative overflow-hidden p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-brand-950 via-zinc-900 to-zinc-950 border border-brand-900/40 text-white shadow-xl flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div class="space-y-1.5 z-10">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-brand-500/20 text-brand-300 text-[11px] font-bold tracking-wide uppercase">
          Studio Sanctuary
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Studio Dashboard</h1>
        <p class="text-xs text-zinc-300 max-w-lg leading-relaxed">
          Craft timeless ideas, review reader interactions, manage taxonomy, and publish essays with precision.
        </p>
      </div>
      <a
        href="/admin/editor/new"
        class="z-10 inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs shadow-lg transition-all self-start active:scale-95 shrink-0"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Write Article
      </a>
      <div class="absolute -right-8 -bottom-8 w-48 h-48 bg-brand-600/10 rounded-full blur-2xl pointer-events-none"></div>
    </div>

    {/* Metric Cards */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
        <div class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Total Articles</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-zinc-50 mt-1">{totalArticles || 0}</div>
      </div>
      <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
        <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Published Live</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">{publishedArticles || 0}</div>
      </div>
      <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
        <div class="text-xs font-semibold text-amber-600 dark:text-amber-400 uppercase tracking-wider">Active Drafts</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-amber-600 dark:text-amber-400 mt-1">{draftArticles || 0}</div>
      </div>
      <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
        <div class="text-xs font-semibold text-purple-600 dark:text-purple-400 uppercase tracking-wider">
          {userRole === 'admin' ? 'Editor Requests' : 'Discussions'}
        </div>
        <div class="text-2xl sm:text-3xl font-extrabold text-purple-600 dark:text-purple-400 mt-1">
          {userRole === 'admin' ? (pendingRequestsCount || 0) : (totalComments || 0)}
        </div>
      </div>
    </div>

    {/* Master Admin: Pending Editor Applications Queue */}
    {userRole === 'admin' && pendingEditorRequests.length > 0 && (
      <div class="p-6 rounded-3xl bg-amber-50/50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800/60 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
            <h2 class="text-base font-bold text-zinc-950 dark:text-zinc-50">
              Pending Editor Applications ({pendingEditorRequests.length})
            </h2>
          </div>
          <a href="/admin/users" class="text-xs font-bold text-brand-600 hover:underline">
            Manage All Approvals →
          </a>
        </div>

        <div class="divide-y divide-amber-200/60 dark:divide-amber-800/40">
          {pendingEditorRequests.map((req) => (
            <div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-xs text-zinc-900 dark:text-zinc-100">
                    {req.user?.full_name || 'Reader'}
                  </span>
                  <span class="text-[11px] text-zinc-400">({req.user?.email})</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200">
                    Pending
                  </span>
                </div>
                <p class="text-xs text-zinc-600 dark:text-zinc-400 italic">
                  "{req.reason}"
                </p>
              </div>

              <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
                <a
                  href="/admin/users"
                  class="px-3 py-1.5 text-xs font-bold rounded-xl bg-brand-600 hover:bg-brand-500 text-white shadow-xs transition-all"
                >
                  Review & Approve
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Recent Articles Section */}
    <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xs space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-bold text-zinc-950 dark:text-zinc-50">Recently Updated Articles</h2>
        <a href="/admin/articles" class="text-xs font-bold text-brand-600 hover:underline">
          View All →
        </a>
      </div>

      <div class="divide-y divide-zinc-100 dark:divide-zinc-800">
        {(!recentArticles || recentArticles.length === 0) ? (
          <div class="py-8 text-center text-xs text-zinc-400">No articles yet. Start by creating one!</div>
        ) : (
          recentArticles.map((art) => (
            <div class="py-3 flex items-center justify-between gap-4">
              <div class="overflow-hidden">
                <a href={`/admin/editor/${art.id}`} class="text-xs font-bold text-zinc-900 dark:text-zinc-100 hover:text-brand-600 truncate block">
                  {art.title || 'Untitled Draft'}
                </a>
                <div class="text-[11px] text-zinc-400 flex items-center gap-2 mt-0.5 font-sans">
                  <span>{art.category?.name || 'Uncategorized'}</span>
                  <span>•</span>
                  <span>Updated {formatShortDate(art.updated_at)}</span>
                </div>
              </div>

              <div class="flex items-center gap-2 shrink-0">
                <span class={`px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${
                  art.status === 'published'
                    ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
                    : 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'
                }`}>
                  {art.status}
                </span>
                <a href={`/admin/editor/${art.id}`} class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-100 dark:bg-zinc-800 hover:bg-brand-500 hover:text-white transition-colors">
                  Edit
                </a>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </div>
</AdminLayout>
