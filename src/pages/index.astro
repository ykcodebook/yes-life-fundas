---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
import HeroSlider from '../components/home/HeroSlider';
import { createServerSupabaseClient } from '../lib/supabase/server';

const client = createServerSupabaseClient(Astro.cookies);

// Fetch published articles, categories, and tags
const [{ data: articles }, { data: categories }] = await Promise.all([
  client
    .from('articles')
    .select('*, author:profiles(*), category:categories(*)')
    .eq('status', 'published')
    .order('published_at', { ascending: false }),
  client.from('categories').select('*').order('name'),
]);

const publishedArticles = articles || [];
---

<BaseLayout
  title="Yes Life Fundas — Wisdom, Holistic Healing, Philosophy & Intentional Living"
  description="Explore deep-dive essays on somatic healing, nervous system regulation, slow living, ancient philosophy, and timeless life fundamentals."
>
  {/* 1. Full-Width Sliding Banner on Top */}
  <HeroSlider client:load featuredArticles={publishedArticles} />

  {/* 2. Main Content Container */}
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14 space-y-14 sm:space-y-20">
    
    {/* Editorial Mission & Thematic Category Navigation */}
    <div class="text-center max-w-3xl mx-auto space-y-6">
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400 font-sans">
          Editorial Sanctuary
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-sans tracking-tight text-zinc-950 dark:text-zinc-50">
          Curated Reflections & Life Fundas
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-serif leading-relaxed">
          Explore thoughtful perspectives on restoring nervous system equilibrium, practicing ancient philosophy, and crafting a life of quiet depth.
        </p>
      </div>

      {/* Category Pills */}
      {categories && categories.length > 0 && (
        <div class="flex flex-wrap items-center justify-center gap-2 pt-2 font-sans">
          {categories.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="px-4 py-2 rounded-full text-xs font-bold bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-brand-500 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-brand-50/50 dark:hover:bg-zinc-800 transition-all shadow-2xs"
            >
              {cat.name}
            </a>
          ))}
        </div>
      )}
    </div>

    {/* Latest Articles Grid */}
    {publishedArticles.length > 0 ? (
      <section class="space-y-6">
        <div class="flex items-center justify-between border-b border-zinc-200/80 dark:border-zinc-800/80 pb-4">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-500"></span>
            <h3 class="text-lg sm:text-xl font-bold font-sans tracking-tight text-zinc-950 dark:text-zinc-50">
              Recent Publications
            </h3>
          </div>
          <span class="text-xs font-sans text-zinc-400 font-medium">
            {publishedArticles.length} {publishedArticles.length === 1 ? 'essay' : 'essays'}
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {publishedArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      </section>
    ) : (
      <div class="py-16 text-center bg-white dark:bg-zinc-900 rounded-3xl border border-dashed border-zinc-200 dark:border-zinc-800 p-8">
        <h3 class="text-base font-bold text-zinc-800 dark:text-zinc-200">No essays published yet</h3>
        <p class="text-xs text-zinc-500 mt-1 mb-4">Start by writing your first reflection in the author studio.</p>
        <a
          href="/admin/editor/new"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-brand-600 text-white rounded-xl text-xs font-bold shadow-md hover:bg-brand-500"
        >
          Compose Essay
        </a>
      </div>
    )}

    {/* Clean, Refined RSS & Sanctuary Feed Section */}
    <section class="relative overflow-hidden rounded-3xl bg-zinc-950 text-white border border-zinc-800/80 shadow-2xl p-8 sm:p-12 font-sans">
      {/* Ambient background glow */}
      <div class="absolute -right-16 -bottom-16 w-80 h-80 bg-brand-600/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -top-16 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        {/* Left Column: Heading & Content */}
        <div class="lg:col-span-7 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 text-[11px] font-bold uppercase tracking-wider">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
            </svg>
            <span>Quiet Feeds • Zero Algorithms</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-snug">
            Receive Quiet Wisdom in Your Reader
          </h3>

          <p class="text-xs sm:text-sm font-serif text-zinc-300 leading-relaxed max-w-xl">
            Subscribe directly to our open RSS feed. No spam newsletters, tracking trackers, or algorithmic noise—just long-form essays on healing, somatic wellness, and timeless philosophy delivered to your favorite reader.
          </p>
        </div>

        {/* Right Column: Actions */}
        <div class="lg:col-span-5 flex flex-col sm:flex-row lg:flex-col items-stretch sm:items-center lg:items-stretch gap-3">
          <a
            href="/rss.xml"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold shadow-lg shadow-brand-600/30 transition-all active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
            </svg>
            <span>Open Direct RSS Feed</span>
          </a>

          <a
            href="/category/holistic-healing"
            class="flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-zinc-900/80 hover:bg-zinc-800 text-zinc-300 hover:text-white border border-zinc-800 text-xs font-semibold transition-colors text-center"
          >
            Browse Healing & Wisdom Archive →
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
