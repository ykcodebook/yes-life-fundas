---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import Breadcrumbs from '../../components/core/Breadcrumbs.astro';
import { createServerSupabaseClient } from '../../lib/supabase/server';

const { username } = Astro.params;
const client = createServerSupabaseClient(Astro.cookies);

// Fetch author profile
const { data: author } = await client
  .from('profiles')
  .select('*')
  .eq('username', username)
  .single();

if (!author) {
  return Astro.rewrite('/404');
}

// Fetch author's published articles
const { data: articles } = await client
  .from('articles')
  .select('*, author:profiles(*), category:categories(*)')
  .eq('author_id', author.id)
  .eq('status', 'published')
  .order('published_at', { ascending: false });

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Authors', url: '/' },
  { name: author.full_name, url: `/author/${author.username}` },
];
---

<BaseLayout
  title={`${author.full_name} | Author on Yes Life Fundas`}
  description={author.bio || `Read articles and essays by ${author.full_name}`}
  ogType="profile"
  authorName={author.full_name}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10 font-sans">
    <Breadcrumbs items={breadcrumbItems} />

    {/* Author Profile Header Card */}
    <div class="p-8 sm:p-12 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-sm flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
      {author.avatar_url ? (
        <img
          src={author.avatar_url}
          alt={author.full_name}
          class="w-24 h-24 rounded-3xl object-cover ring-4 ring-brand-500/20 shadow-md"
        />
      ) : (
        <div class="w-24 h-24 rounded-3xl bg-brand-600 text-white flex items-center justify-center text-3xl font-bold shadow-md">
          {author.full_name?.charAt(0) || 'A'}
        </div>
      )}

      <div class="space-y-3 flex-1">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-zinc-50">
            {author.full_name}
          </h1>
          <div class="text-xs text-brand-600 font-mono font-semibold mt-0.5">
            @{author.username}
          </div>
        </div>

        <p class="text-sm font-serif text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
          {author.bio || 'Author and thinker exploring technology architecture, mental models, and life principles.'}
        </p>

        {author.website && (
          <div class="pt-1">
            <a
              href={author.website}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold text-brand-600 hover:underline inline-flex items-center gap-1"
            >
              {author.website.replace(/^https?:\/\//, '')} ↗
            </a>
          </div>
        )}
      </div>
    </div>

    {/* Articles by Author */}
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3">
        <h2 class="text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
          Published Articles ({articles?.length || 0})
        </h2>
      </div>

      {(!articles || articles.length === 0) ? (
        <div class="py-12 text-center text-zinc-400">
          No published articles yet from this author.
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
